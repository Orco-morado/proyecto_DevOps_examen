# CONFIGURACIÓN ÚNICA DE MAQUINARIA MYSQL 
MYSQL_ROOT_PASSWORD=super_secure_root_pass123
MYSQL_USER=devops_user
MYSQL_PASSWORD=devops_secure_password

# Base de datos individuales (Se crearán automáticamente o mediante script)
MYSQL_DB_DESPACHO=db_despacho
MYSQL_DB_VENTA=db_venta

# CONEXIÓN BACKEND DESPACHO  
SPRING_DESPACHO_URL=jdbc:mysql://db-sistema:3306/db_despacho?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
SPRING_DESPACHO_USER=devops_user
SPRING_DESPACHO_PASS=devops_secure_password

# CONEXIÓN BACKEND VENTA 
SPRING_VENTA_URL=jdbc:mysql://db-sistema:3306/db_venta?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
SPRING_VENTA_USER=devops_user
SPRING_VENTA_PASS=devops_secure_password

# CONFIGURACIÓN FRONTEND

# Cambia 'TU_IP_PUBLICA_AWS' por la IP elástica de tu EC2 cuando la lances
REACT_APP_API_DESPACHO_URL=http://TU_IP_PUBLICA_AWS:8081
REACT_APP_API_VENTA_URL=http://TU_IP_PUBLICA_AWS:8082